# NoPear worker — copy to .env and fill in. Never commit real secrets.
NOPEAR_SAAS_URL=https://nopear.example.com
# Only needed when the SaaS sets SAAS_BOOTSTRAP_TOKEN (keep the value outside the repo).
NOPEAR_SAAS_BOOTSTRAP_TOKEN=
# Machine name shown in the console (default: hostname)
NOPEAR_LABEL=
NOPEAR_HOME=~/.nopear
# Default working directory for new sessions (default: $HOME)
NOPEAR_DEFAULT_CWD=
# provider/modelId from your pi models.json; empty = first available model
NOPEAR_DEFAULT_MODEL=
NOPEAR_DEFAULT_THINKING=medium
NOPEAR_PI_AUTH=~/.pi/agent/auth.json
NOPEAR_PI_MODELS=~/.pi/agent/models.json
# How the agent introduces itself in the system prompt
NOPEAR_PERSONA=Claude Code
NOPEAR_ASK_TIMEOUT_MS=0
NOPEAR_IDLE_DISPOSE_MS=600000
# auto = follow the account's E2E switch; required = refuse every plaintext frame
# NOPEAR_E2E=auto
# Max cards executed concurrently on this machine (integer ≥ 1)
# NOPEAR_CARD_WIP=1
# ipv4first (default) avoids stalled tunnels on hosts with a flaky IPv6 path; verbatim = OS order
# NOPEAR_DNS_ORDER=ipv4first
# One-time install code: written by the install script and removed after registration
# NOPEAR_INSTALL_CODE=
