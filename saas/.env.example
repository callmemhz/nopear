# NoPear SaaS — copy to .env and fill in. Never commit real secrets; keep them outside the repo.
SAAS_PORT=8790
SAAS_PUBLIC_URL=https://nopear.example.com
SAAS_DATA_DIR=./.saas
# SAAS_DB=sqlite:./.saas/saas.db
# SAAS_SIGNING_KEY=<b64url 32-byte ed25519 seed; default: generated into $SAAS_DATA_DIR/signing.key — losing it invalidates every worker's pin>
# SAAS_SESSION_SECRET=<random; default: generated into $SAAS_DATA_DIR/session.secret>
# Google login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email-only dev login. Never enable on a public deployment.
SAAS_DEV_LOGIN=0
# Require this token to register a worker (optional)
SAAS_BOOTSTRAP_TOKEN=
# First admin of the login allowlist (only applied while the allowlist is empty)
# SAAS_BOOTSTRAP_ADMIN=you@example.com
SAAS_REDIRECT_ALLOWLIST=nopear://
SAAS_BODY_LIMIT_MB=64
SAAS_WEB_DIR=../web/dist
# Prebuilt worker package served at /install/worker.tgz (the Docker image sets it)
# SAAS_WORKER_TGZ=
